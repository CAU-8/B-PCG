<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- Godot 4.7.2 .NET 판 게임 프로젝트. 계산은 ../src/Bpcg 라이브러리가 하고, 여기는 장면·화면·입력만 둡니다.
       Godot.NET.Sdk 는 이 폴더 아래 모든 .cs 를 컴파일하므로 Bpcg 는 폴더 밖에 둡니다 (docs/csharp_port.md 1장). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Bpcg.Engine</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 생성 계산이 무거우므로 편집기 실행(Debug)에서도 Bpcg 는 최적화(Release)해 빌드합니다. -->
    <ProjectReference Include="../src/Bpcg/Bpcg.csproj" SetConfiguration="Configuration=Release" />
  </ItemGroup>
  <ItemGroup>
    <!-- 아래 두 런타임 설정은 이 프로젝트의 runtimeconfig.json 을 읽는 실행에만 들어갑니다. Godot 편집기 실행 파일로
         프로젝트를 돌리면(편집기, 명령줄에서 engine 폴더를 주어 실행, 스튜디오의 'Godot로 보기') Godot 가 자기 설치 폴더의
         GodotPlugins.runtimeconfig.json 으로 .NET 을 띄워 이 값을 읽지 않습니다 (엔진 안에서 재어 확인함). 스튜디오는
         같은 값을 환경 변수 DOTNET_GCConserveMemory·DOTNET_TC_CallCountingDelayMs 로 줍니다 (src/bpcg_studio/godot.py
         의 RUNTIME_ENV). 내보낸(export) 게임에서 이 값이 들어가는지는 확인하지 않았습니다. -->
    <!-- GC 가 다 쓴 큰 배열을 더 일찍 거두게 합니다 (0–9, 클수록 힙을 작게 유지). laptop all 최대 메모리 10.0 → 5.75 GB, 걸린 시간 +2% 였습니다. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <!-- 자주 부르는 메서드를 곧바로 최적화 컴파일로 올립니다. 기본값은 새 메서드가 컴파일되는 동안 100 ms 씩 미루는데,
         단계마다 새 코드가 나와서 계속 미뤄지고, 한 번만 도는 큰 반복이 덜 최적화된 코드로 돕니다. 계산 결과는 같고,
         이 값만 바꿔 잰 laptop all 이 49.2 → 44.1 s 였습니다. -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>
</Project>
